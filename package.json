{
  "name": "@railgun-reloaded/storage",
  "version": "0.0.1",
  "description": "Persistence layer for RAILGUN Reloaded using Drizzle ORM with SQLite",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    }
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "drizzle/**/*.sql",
    "drizzle/**/*.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && (git clean -fXq src test || true)",
    "prepare": "npm run clean && npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:package": "publint",
    "check:browser": "esbuild src/index.js --bundle --platform=browser --format=esm --outfile=/dev/null",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps \"test/**/*.test.js\"",
    "db:generate:chain": "tsc --build && drizzle-kit generate --config=config/drizzle.chain.config.ts",
    "db:generate:wallet": "tsc --build && drizzle-kit generate --config=config/drizzle.wallet.config.ts",
    "db:generate": "npm run db:generate:chain && npm run db:generate:wallet",
    "db:studio:chain": "tsc --build && drizzle-kit studio --config=config/drizzle.chain.config.ts",
    "db:studio:wallet": "tsc --build && drizzle-kit studio --config=config/drizzle.wallet.config.ts"
  },
  "keywords": [
    "railgun",
    "storage",
    "persistence",
    "sqlite",
    "drizzle",
    "database"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev",
    "@types/better-sqlite3": "^7.6.12",
    "drizzle-orm": "^0.36.4"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@types/node": "^24.0.3",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.29.1",
    "esbuild": "^0.28.1",
    "publint": "^0.3.21",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
