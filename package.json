{
  "name": "@railgun-reloaded/storage",
  "version": "0.0.1",
  "description": "Persistence layer for RAILGUN Reloaded using Drizzle ORM with SQLite",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "scripts": {
    "build": "npm run db:generate && tsc --build",
    "clean": "tsc --build --clean",
    "prepare": "npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps \"test/**/*.test.js\"",
    "db:generate:chain": "drizzle-kit generate --config=config/drizzle.chain.config.ts",
    "db:generate:wallet": "drizzle-kit generate --config=config/drizzle.wallet.config.ts",
    "db:generate": "npm run db:generate:chain && npm run db:generate:wallet",
    "db:studio:chain": "drizzle-kit studio --config=config/drizzle.chain.config.ts",
    "db:studio:wallet": "drizzle-kit studio --config=config/drizzle.wallet.config.ts"
  },
  "bin": {
    "db-generate-chain": "./bin/bin.js"
  },
  "keywords": [
    "railgun",
    "storage",
    "persistence",
    "sqlite",
    "drizzle",
    "database"
  ],
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@railgun-reloaded/bytes": "git+https://github.com/railgun-reloaded/bytes.git#dev",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@types/node": "^24.0.3",
    "drizzle-kit": "^0.29.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
